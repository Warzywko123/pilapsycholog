{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/psycholog-pila.html", "destination": "/", "permanent": true },
    { "source": "/psychoterapeuta-pila.html", "destination": "/", "permanent": true },
    { "source": "/oferta.html", "destination": "/#oferta", "permanent": true },
    { "source": "/cennik-psycholog-pila.html", "destination": "/#faq", "permanent": true },
    { "source": "/utrata-prawa-jazdy-pila.html", "destination": "/#oferta", "permanent": true },
    { "source": "/kontak-psycholog-pila.html", "destination": "/#kontakt", "permanent": true },
    { "source": "/kontakt-psycholog-pila.html", "destination": "/#kontakt", "permanent": true },
    { "source": "/oferta/psycholog-dzieciecy-pila.html", "destination": "/#oferta", "permanent": true },
    { "source": "/oferta/psycholog-online.html", "destination": "/#oferta", "permanent": true },
    { "source": "/oferta/psycholog-od-uzaleznien-pila.html", "destination": "/#oferta", "permanent": true },
    { "source": "/oferta/(.*)", "destination": "/#oferta", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; frame-src https://*.google.com https://maps.google.com"
        }
      ]
    },
    {
      "source": "/(css|js|obrazy)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:html|xml|txt|webmanifest))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
